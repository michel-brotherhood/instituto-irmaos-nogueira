# Copie para .env e preencha. Variáveis PUBLIC_ vão para o navegador.
# Sem valor, e-mail, redes e formulário de inscrição usam os dados publicados hoje no site do Instituto (src/data/site.ts).
PUBLIC_CONTACT_EMAIL=
PUBLIC_WHATSAPP=            # só dígitos, com DDI: 5521999999999
PUBLIC_INSTAGRAM_URL=
PUBLIC_YOUTUBE_URL=
PUBLIC_FACEBOOK_URL=
PUBLIC_SIGNUP_FORM_URL=     # formulário de matrícula (ex.: Google Form)
PUBLIC_DONATION_CHECKOUT_URL=  # checkout de cartão/recorrência (Asaas, Mercado Pago...)
PUBLIC_SPONSOR_FORM_ENDPOINT=  # endpoint POST do formulário de patrocínio (Formspree, n8n, CRM...)
PUBLIC_DPO_EMAIL=           # e-mail do encarregado de dados (LGPD)
PUBLIC_GA_ID=               # GA4, carregado só após consentimento

# ---- Infra (não vão para o site) ----
HOST_PORT=8080              # porta local (127.0.0.1) que o proxy reverso da VPS acessa
# Sem nginx/Caddy/Traefik na VPS? descomente para subir o Caddy junto (HTTPS automático nas portas 80/443):
# COMPOSE_FILE=docker-compose.yml:deploy/compose.caddy.yml
