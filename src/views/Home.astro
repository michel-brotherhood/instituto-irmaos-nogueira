---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Deco from '../components/Deco.astro';
import NucleoCard from '../components/NucleoCard.astro';
import OdsGrid from '../components/OdsGrid.astro';
import PartnerGrid from '../components/PartnerGrid.astro';
import PixCard from '../components/PixCard.astro';
import HomeHero from '../components/home/HomeHero.astro';
import Manifesto from '../components/home/Manifesto.astro';
import { IMG, getContent } from '../data/content';
import { SITE } from '../data/site';
import { i18n } from '../i18n/config';
import { t } from '../i18n/ui';

const { lang, l } = i18n(Astro.url);
const { STATS, PRINCIPIOS, NUCLEOS, TIMELINE } = getContent(lang);

