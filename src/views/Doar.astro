---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { IMG } from '../data/content';
import PageHero from '../components/PageHero.astro';
import PixCard from '../components/PixCard.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { i18n } from '../i18n/config';
import { t } from '../i18n/ui';

const { lang, l } = i18n(Astro.url);
const ui = t(lang);

/** Divide um texto em partes normais e placeholders `[...]`. */
const parts = (s: string) => s.split(/(\[[^\]]+\])/).filter(Boolean).map((t) => ({ t, ph: /^\[.*\]$/.test(t) }));

const DEFAULT = { freq: 'mensal', valor: 50, metodo: 'pix' } as const;

const COPY = {
  pt: {
    metaTitle: 'Doe agora',
    metaDescription: 'Doe via PIX ou cartão para o Instituto Irmãos Nogueira e ajude crianças e jovens a treinar Jiu-Jitsu, Muay Thai e Boxe. Doação única ou mensal.',
    eyebrow: 'Doação',
    heroAlt: 'Rodrigo Minotauro sorrindo, cercado de crianças do Instituto em uma arena',
    title: 'Ajude a formar faixas-pretas na vida.',
    lead: 'Centenas de crianças dependem de quem acredita no esporte como caminho. Doe uma vez ou vire apoiador mensal.',
    widgetTitle: 'Faça sua doação',
    freqLabel: 'Frequência',
    freqs: { unica: 'Doação única', mensal: 'Quero doar todo mês' },
    valueLabel: 'Escolha um valor',
    otherChip: 'Outro',
    otherField: 'Outro valor (R$)',
    otherPlaceholder: 'Ex.: 80',
    impactos: {
      25: 'R$ 25 ajuda a garantir o lanche de um aluno por [X] dias.',
      50: 'R$ 50 ajuda a manter um aluno no tatame por [X] mês.',
      100: 'R$ 100 ajuda a comprar [X] quimonos para novos alunos.',
      200: 'R$ 200 ajuda a custear o transporte de uma turma para [competição/evento].',
      500: 'R$ 500 ajuda a equipar [X] alunos de um núcleo.',
      0: 'Qualquer valor faz diferença na rotina dos núcleos.',
    } as Record<number, string>,
    impactPh: '[validar valores de impacto]',
    methodLabel: 'Forma de pagamento',
    methods: { pix: 'PIX', card: 'Cartão de crédito' },
    recurringNote: 'Para doar todo mês de forma automática, prefira o cartão de crédito. Pelo PIX, a doação é feita uma vez.',
    intl: null as null | { lead: string; card: string; or: string; write: string; help: string },
    cardTxt: 'Dados do cartão no checkout seguro',
    cardOf: ' de ',
    cardPh: '[checkout do gateway]',
    cta: { donate: 'Doar', other: 'outro valor', monthly: ' por mês' },
    cnpj: 'CNPJ',
    accounts: 'Veja nossa prestação de contas',
    transfer: 'Transferência',
    agency: 'Ag.',
    account: 'C/C',
    destTitle: 'Para onde vai sua doação',
    destinos: ['Equipamentos esportivos', 'Professores', 'Assistentes sociais e equipe', 'Lanche para os alunos', 'Transporte para as atividades'],
    bizEyebrow: 'Você representa uma empresa?',
    bizTitle: 'Patrocine com parte do imposto devido →',
  },
  en: {
    metaTitle: 'Donate now',
    metaDescription: 'Donate via PIX or card to Instituto Irmãos Nogueira and help kids and teens train in Jiu-Jitsu, Muay Thai and Boxing. One-time or monthly gifts.',
    eyebrow: 'Donate',
    heroAlt: 'Rodrigo Minotauro smiling, surrounded by children from the Institute in an arena',
    title: 'Help raise black belts for life.',
    lead: 'Hundreds of kids are counting on people who believe sport can change a life. Give once or become a monthly supporter.',
    widgetTitle: 'Make your donation',
    freqLabel: 'Frequency',
    freqs: { unica: 'One-time gift', mensal: 'Give every month' },
    valueLabel: 'Choose an amount',
    otherChip: 'Other',
    otherField: 'Other amount (R$)',
    otherPlaceholder: 'e.g. 80',
    impactos: {
      25: 'R$ 25 helps cover a student’s snacks for [X] days.',
      50: 'R$ 50 helps keep a student on the mat for [X] month.',
      100: 'R$ 100 helps buy [X] gis for new students.',
      200: 'R$ 200 helps pay for a class to travel to [competition/event].',
      500: 'R$ 500 helps equip [X] students at one of our training centers.',
      0: 'Every amount makes a difference in the day-to-day life of our centers.',
    } as Record<number, string>,
    impactPh: '[validate impact figures]',
    methodLabel: 'Payment method',
    methods: { pix: 'PIX', card: 'Credit card' },
    recurringNote: 'To give automatically every month, choose credit card. PIX donations are one-time only.',
    intl: {
      lead: 'PIX is a Brazilian payment method. Outside Brazil?',
      card: 'Donate by card',
      or: ' or write to us at ',
      write: ' Write to us at ',
      help: ' and we’ll help you give.',
    } as null | { lead: string; card: string; or: string; write: string; help: string },
    cardTxt: 'Enter your card details at the secure checkout',
    cardOf: ' of ',
    cardPh: '[payment gateway checkout]',
    cta: { donate: 'Donate', other: 'a custom amount', monthly: ' a month' },
    cnpj: 'CNPJ',
    accounts: 'See our financial reports',
    transfer: 'Bank transfer (Brazil)',
    agency: 'Branch',
    account: 'Account',
    destTitle: 'Where your gift goes',
    destinos: ['Sports equipment', 'Instructors', 'Social workers and staff', 'Snacks for students', 'Transportation to activities'],
    bizEyebrow: 'Representing a company?',
    bizTitle: 'Sponsor us with taxes owed in Brazil →',
  },
  es: {
    metaTitle: 'Dona ahora',
    metaDescription: 'Dona vía PIX o tarjeta al Instituto Irmãos Nogueira y ayuda a niños y jóvenes a entrenar Jiu-Jitsu, Muay Thai y Boxeo. Donación única o mensual.',
    eyebrow: 'Donación',
    heroAlt: 'Rodrigo Minotauro sonriendo, rodeado de niños del Instituto en una arena',
    title: 'Ayuda a formar cinturones negros para la vida.',
    lead: 'Cientos de niños dependen de quienes creen en el deporte como camino. Dona una vez o hazte donante mensual.',
    widgetTitle: 'Haz tu donación',
    freqLabel: 'Frecuencia',
    freqs: { unica: 'Donación única', mensal: 'Quiero donar cada mes' },
    valueLabel: 'Elige un monto',
    otherChip: 'Otro',
    otherField: 'Otro monto (R$)',
    otherPlaceholder: 'Ej.: 80',
    impactos: {
      25: 'R$ 25 ayuda a garantizar la merienda de un alumno durante [X] días.',
      50: 'R$ 50 ayuda a mantener a un alumno en el tatami durante [X] mes.',
      100: 'R$ 100 ayuda a comprar [X] kimonos para alumnos nuevos.',
      200: 'R$ 200 ayuda a costear el transporte de un grupo a [competencia/evento].',
      500: 'R$ 500 ayuda a equipar a [X] alumnos de un centro.',
      0: 'Cualquier monto marca la diferencia en el día a día de los centros.',
    } as Record<number, string>,
    impactPh: '[validar cifras de impacto]',
    methodLabel: 'Forma de pago',
    methods: { pix: 'PIX', card: 'Tarjeta de crédito' },
    recurringNote: 'Para donar automáticamente cada mes, elige la tarjeta de crédito. Por PIX, la donación se hace una sola vez.',
    intl: {
      lead: 'PIX es un medio de pago brasileño. ¿Estás fuera de Brasil?',
      card: 'Dona con tarjeta',
      or: ' o escríbenos a ',
      write: ' Escríbenos a ',
      help: ' y te ayudamos a donar.',
    } as null | { lead: string; card: string; or: string; write: string; help: string },
    cardTxt: 'Ingresa los datos de tu tarjeta en el checkout seguro',
    cardOf: ' de ',
    cardPh: '[checkout de la pasarela de pago]',
    cta: { donate: 'Donar', other: 'otro monto', monthly: ' al mes' },
    cnpj: 'CNPJ',
    accounts: 'Consulta nuestra rendición de cuentas',
    transfer: 'Transferencia (Brasil)',
    agency: 'Ag.',
    account: 'Cta.',
    destTitle: 'A dónde va tu donación',
    destinos: ['Equipamiento deportivo', 'Profesores', 'Trabajadores sociales y equipo', 'Merienda para los alumnos', 'Transporte a las actividades'],
    bizEyebrow: '¿Representas a una empresa?',
    bizTitle: 'Patrocina con impuestos que pagas en Brasil →',
  },
};
const T = COPY[lang];

const freqs = [
  { k: 'unica', label: T.freqs.unica },
  { k: 'mensal', label: T.freqs.mensal },
];
const valores = [25, 50, 100, 200, 500, 0];
const impactos = T.impactos;
const metodos = [
  { k: 'pix', label: T.methods.pix },
  { k: 'card', label: T.methods.card },
];
const destinos = T.destinos;

const checkout = SITE.links.donationCheckout;
const contactEmail = SITE.contact.email;
const ctaLabel = (v: number, f: string) => `${T.cta.donate} ${v ? `R$ ${v}` : T.cta.other}${f === 'mensal' ? T.cta.monthly : ''}`;
---
<BaseLayout
  title={T.metaTitle}
  description={T.metaDescription}
  stickyDonate={false}
>
  <div class="doar-hero">
    <PageHero
      tone="red"
      eyebrow={T.eyebrow}
      title={T.title}
      lead={T.lead}
    >
      <div slot="aside" class="doar-hero__photo">
        <Image src={IMG.minotauroCriancas} alt={T.heroAlt} widths={[480, 720, 1024]} sizes="(max-width: 1040px) 100vw, 560px" loading="eager" fetchpriority="high" />
      </div>
    </PageHero>
  </div>

  <section class="container donate" aria-labelledby="doar-titulo">
    <div class="widget" data-donate data-checkout={checkout ?? ''} data-freq={DEFAULT.freq} data-valor={DEFAULT.valor} data-metodo={DEFAULT.metodo} data-t-donate={T.cta.donate} data-t-other={T.cta.other} data-t-monthly={T.cta.monthly}>
      <h2 class="sr-only" id="doar-titulo">{T.widgetTitle}</h2>
      <div class="toggle" role="group" aria-label={T.freqLabel}>
        {freqs.map((f) => (
          <button type="button" class="toggle__btn" data-freq-opt={f.k} aria-pressed={(f.k === DEFAULT.freq) ? 'true' : 'false'}>{f.label}</button>
        ))}
      </div>

      <div class="widget__block">
        <p class="widget__label" id="valor-label">{T.valueLabel}</p>
        <div class="chips" role="group" aria-labelledby="valor-label">
          {valores.map((v) => (
            <button type="button" class="chip" data-valor-opt={v} aria-pressed={(v === DEFAULT.valor) ? 'true' : 'false'}>{v ? `R$ ${v}` : T.otherChip}</button>
          ))}
        </div>
        <label class="field other" for="valor-outro" data-other hidden>
          {T.otherField}
          <input id="valor-outro" type="number" inputmode="numeric" min="1" step="1" placeholder={T.otherPlaceholder} />
        </label>
        <div class="impact">
          <Icon name="heart" size={22} strokeWidth={2} class="impact__ico" />
          <div>
            {valores.map((v) => (
              <p class="impact__txt" data-impact={v} hidden={v !== DEFAULT.valor}>
                {parts(impactos[v]).map((p) => (p.ph ? <span class="ph">{p.t}</span> : p.t))}{' '}
                <span class="ph">{T.impactPh}</span>
              </p>
            ))}
          </div>
        </div>
      </div>

      <div class="widget__block">
        <p class="widget__label" id="metodo-label">{T.methodLabel}</p>
        <div class="methods" role="group" aria-labelledby="metodo-label">
          {metodos.map((m) => (
            <button type="button" class="method" data-metodo-opt={m.k} aria-pressed={(m.k === DEFAULT.metodo) ? 'true' : 'false'}>{m.label}</button>
          ))}
        </div>
      </div>

      <div id="doar-pix" class="pane" data-pane="pix" tabindex="-1">
        {T.intl && (
          <p class="note note--intl">
            {T.intl.lead}
            {checkout ? (
              <Fragment>
                {' '}<a href={checkout} target="_blank" rel="noopener">{T.intl.card}<span class="sr-only"> {ui.newTab}</span></a>{T.intl.or}<a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
              </Fragment>
            ) : (
              <Fragment>
                {T.intl.write}<a href={`mailto:${contactEmail}`}>{contactEmail}</a>{T.intl.help}
              </Fragment>
            )}
          </p>
        )}
        <p class="note" data-recurring-note hidden>
          {T.recurringNote}
        </p>
        <PixCard />
      </div>

      <div class="pane pane--card" data-pane="card" hidden>
        <p class="pane__txt">
          {T.cardTxt}{checkout ? '.' : T.cardOf}
          {!checkout && <span class="ph">{T.cardPh}</span>}
        </p>
      </div>

      <a
        href="#doar-pix"
        class="btn btn--lg btn--block"
        data-donate-cta
        data-track="donate_click"
        data-track-source="doar_widget"
      >
        <span class="btn__label" data-cta-label>{ctaLabel(DEFAULT.valor, DEFAULT.freq)}</span>
        <span class="btn__icon"><Icon name="arrow" size={18} strokeWidth={2.4} /></span>
        <span class="sr-only" data-cta-ext hidden>{ui.newTab}</span>
      </a>

      <div class="widget__foot">
        <span>{T.cnpj} {SITE.cnpj}</span>
        <a href={l('/transparencia/')}>{T.accounts}</a>
        <span>{T.transfer}: {SITE.bank.name} · {T.agency} {SITE.bank.agency} · {T.account} {SITE.bank.account}</span>
      </div>
      <p class="sr-only" aria-live="polite" data-donate-status></p>
    </div>

    <aside class="aside">
      <div class="dest chamfer">
        <h2 class="dest__title">{T.destTitle}</h2>
        <ul class="dest__list">
          {destinos.map((d) => <li>{d}</li>)}
        </ul>
      </div>
      <a class="biz chamfer card-h" href={l('/empresas/')} data-track="sponsor_click" data-track-source="doar_aside">
        <span class="biz__eyebrow">{T.bizEyebrow}</span>
        <span class="biz__t">{T.bizTitle}</span>
      </a>
    </aside>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-donate]');
  if (root) {
    const checkout = root.dataset.checkout ?? '';
    const tx = { donate: root.dataset.tDonate ?? 'Doar', other: root.dataset.tOther ?? 'outro valor', monthly: root.dataset.tMonthly ?? ' por mês' };
    const state = {
      freq: root.dataset.freq ?? 'mensal',
      valor: Number(root.dataset.valor ?? 50),
      metodo: root.dataset.metodo ?? 'pix',
      outro: 0,
    };
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string) => Array.from(root.querySelectorAll<T>(s));

    const other = $('[data-other]');
    const otherInput = $<HTMLInputElement>('#valor-outro');
    const cta = $<HTMLAnchorElement>('[data-donate-cta]');
    const ctaLabel = $('[data-cta-label]');
    const ctaExt = $('[data-cta-ext]');
    const note = $('[data-recurring-note]');
    let lastPix: number | null = null;

    const amount = () => (state.valor === 0 ? state.outro : state.valor);

    const update = () => {
      const v = amount();
      const mensal = state.freq === 'mensal';

      $$<HTMLButtonElement>('[data-freq-opt]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.freqOpt === state.freq)));
      $$<HTMLButtonElement>('[data-valor-opt]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.valorOpt) === state.valor)));
      $$<HTMLButtonElement>('[data-metodo-opt]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.metodoOpt === state.metodo)));

      other.hidden = state.valor !== 0;
      $$('[data-impact]').forEach((p) => { p.hidden = Number(p.dataset.impact) !== state.valor; });
      $$('[data-pane]').forEach((p) => { p.hidden = p.dataset.pane !== state.metodo; });
      note.hidden = !(mensal && state.metodo === 'pix');

      ctaLabel.textContent = `${tx.donate} ${v ? `R$ ${v}` : tx.other}${mensal ? tx.monthly : ''}`;

      const isCard = state.metodo === 'card';
      if (isCard && checkout) {
        const url = new URL(checkout);
        if (v) url.searchParams.set('valor', String(v));
        url.searchParams.set('frequencia', state.freq);
        cta.href = url.toString();
        cta.target = '_blank';
        cta.rel = 'noopener';
        ctaExt.hidden = false;
        cta.removeAttribute('aria-disabled');
      } else {
        cta.href = isCard ? '#' : '#doar-pix';
        cta.removeAttribute('target');
        cta.removeAttribute('rel');
        ctaExt.hidden = true;
        if (isCard) cta.setAttribute('aria-disabled', 'true');
        else cta.removeAttribute('aria-disabled');
      }
      cta.dataset.trackValue = String(v || '');
      cta.dataset.trackMethod = state.metodo;
      cta.dataset.trackFreq = state.freq;

      // QR Code com valor só para doação única via PIX
      const pixAmount = state.metodo === 'pix' && !mensal ? v : 0;
      if (pixAmount !== lastPix) {
        lastPix = pixAmount;
        document.dispatchEvent(new CustomEvent('pix:amount', { detail: pixAmount }));
      }
    };

    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!btn || !root.contains(btn)) return;
      if (btn.dataset.freqOpt) state.freq = btn.dataset.freqOpt;
      else if (btn.dataset.valorOpt !== undefined) {
        state.valor = Number(btn.dataset.valorOpt);
        if (state.valor === 0) requestAnimationFrame(() => otherInput.focus());
      } else if (btn.dataset.metodoOpt) state.metodo = btn.dataset.metodoOpt;
      else return;
      update();
    });

    otherInput.addEventListener('input', () => {
      const n = Math.floor(Number(otherInput.value));
      state.outro = Number.isFinite(n) && n > 0 ? n : 0;
      update();
    });

    cta.addEventListener('click', (e) => {
      if (cta.getAttribute('aria-disabled') === 'true') { e.preventDefault(); return; }
      if (state.metodo === 'pix') {
        e.preventDefault();
        const pane = $('#doar-pix');
        pane.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
        pane.focus({ preventScroll: true });
      }
    });

    update();
  }
</script>

<style>
  .doar-hero :global(.phero__in) { padding-bottom: clamp(140px, 14vw, 180px); }
  .doar-hero__photo { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #8f1712; clip-path: polygon(0 0, calc(100% - 56px) 0, 100% 56px, 100% 100%, 56px 100%, 0 calc(100% - 56px)); box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25); }
  @media (max-width: 760px) { .doar-hero__photo { aspect-ratio: 16 / 7; clip-path: polygon(0 0, calc(100% - 32px) 0, 100% 32px, 100% 100%, 32px 100%, 0 calc(100% - 32px)); } }
  .doar-hero__photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 45% 30%; }

  .donate { position: relative; margin-top: -112px; padding-bottom: clamp(64px, 8vw, 96px); display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }

  .widget { flex: 999 1 560px; min-width: 0; background: var(--white); border: 1px solid var(--line); box-shadow: 0 30px 60px rgba(20, 20, 20, 0.12); padding: clamp(20px, 4vw, 44px); display: flex; flex-direction: column; gap: 28px; }
  .widget__block { display: flex; flex-direction: column; gap: 12px; }
  .widget__label { font-weight: 800; }

  .toggle { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 2px solid var(--ink); }
  .toggle__btn { min-height: 56px; padding: 6px 10px; border: 0; background: var(--white); color: var(--ink); font-weight: 800; font-size: 16px; line-height: 1.2; cursor: pointer; }
  .chips { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(96px, 100%), 1fr)); gap: 10px; }
  .chip { min-height: 60px; border: 2px solid #cfcbc3; background: var(--white); color: var(--ink); font-weight: 800; font-size: 20px; cursor: pointer; }
  .methods { display: flex; flex-wrap: wrap; gap: 10px; }
  .method { min-height: 52px; padding: 0 24px; border: 2px solid #cfcbc3; background: var(--white); color: var(--ink); font-weight: 700; font-size: 15px; cursor: pointer; }
  .toggle__btn[aria-pressed='true'], .chip[aria-pressed='true'], .method[aria-pressed='true'] { background: var(--ink); color: var(--white); border-color: var(--ink); }
  .chip:hover, .method:hover { border-color: var(--ink); }

  .other { max-width: 260px; }
  .other[hidden] { display: none; }
  .impact { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: var(--bg); font-size: 15px; }
  .impact :global(.impact__ico) { flex: none; color: var(--red); }

  .pane { display: flex; flex-direction: column; gap: 14px; }
  .pane[hidden] { display: none; }
  .pane:focus { outline: none; }
  .pane :global(.pix) { box-shadow: none; border: 1px solid var(--line); }
  .pane--card { padding: 20px; border: 1px solid var(--line); }
  .pane__txt { font-size: 14px; color: var(--text-3); }
  .note { padding: 12px 14px; border-left: 3px solid var(--red); background: var(--bg); font-size: 15px; color: var(--text-2); }
  .note--intl a { color: var(--red); font-weight: 700; }

  [data-donate-cta] { font-size: 19px; }
  [data-donate-cta][aria-disabled='true'] { opacity: 0.55; cursor: not-allowed; }

  .widget__foot { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 13px; color: var(--text-3); }
  .widget__foot a { color: var(--text-2); display: inline-flex; align-items: center; min-height: 44px; margin-block: -12px; }

  .aside { flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .dest { background: var(--ink); color: var(--white); padding: 32px; display: flex; flex-direction: column; gap: 18px; }
  .dest__title { font-family: var(--font-display); font-weight: 800; font-size: 30px; line-height: 1; text-transform: uppercase; }
  .dest__list { display: flex; flex-direction: column; gap: 12px; }
  .dest__list li { display: flex; gap: 12px; align-items: center; color: #ddd; }
  .dest__list li::before { content: ''; flex: none; width: 12px; height: 12px; background: var(--red-lt); clip-path: var(--oct); }
  .biz { display: flex; flex-direction: column; gap: 8px; padding: 28px; background: var(--white); border: 1px solid var(--line); text-decoration: none; color: var(--text); }
  .biz:hover { color: var(--text); }
  .biz__eyebrow { font-size: 12px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--red); }
  .biz__t { font-family: var(--font-display); font-weight: 800; font-size: 26px; line-height: 1; text-transform: uppercase; }
</style>
