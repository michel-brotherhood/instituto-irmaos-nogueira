---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { getContent } from '../data/content';
import { i18n } from '../i18n/config';
import { t } from '../i18n/ui';

const { lang, l } = i18n(Astro.url);
const ui = t(lang);
const { FUNDADORES, TIMELINE } = getContent(lang);

const COPY = {
  pt: {
    home: 'Início',
    crumb: 'Quem somos',
    title: 'Quem somos',
    description: 'Fundado por Rodrigo “Minotauro” e Rogério “Minotouro” Nogueira, o Instituto usa as artes marciais como ferramenta de educação para crianças e jovens.',
    eyebrow: 'O Instituto · Quem somos',
    heroTitle: 'Uma história de superação que virou missão.',
    heroLead: 'Fundado pelos campeões de MMA Rodrigo “Minotauro” e Rogério “Minotouro” Nogueira, o Instituto usa as artes marciais como ferramenta de educação para crianças e jovens.',
    videoLabel: 'Vídeo: conheça o Instituto Irmãos Nogueira',
    foundersEyebrow: 'Idealizadores do projeto',
    foundersTitle: 'Os Irmãos Nogueira',
    foundersLead: 'Antônio Rodrigo Nogueira, o Minotauro, e Antônio Rogério Correia Nogueira, o Minotouro, idealizaram o Instituto para levar a crianças e jovens a mesma base que os formou: superação, disciplina e resiliência.',
    founderAlt: (nome: string, apelido: string) => `${nome}, o ${apelido}`,
    photoPh: '[confirmar foto]',
    founderRole: 'Idealizador',
    cv: 'Currículo',
    tlEyebrow: 'Nossa trajetória',
    tlTitle: 'De trabalho voluntário a milhares de alunos.',
    tlSub: 'Cada ciclo foi viabilizado por leis de incentivo e por empresas que acreditaram no projeto.',
    movesTitle: 'O que nos move',
    quote: '“Superação, disciplina e resiliência sempre estiveram presentes na vida dos Irmãos Nogueira.”',
    valores: ['Superação', 'Disciplina', 'Resiliência'],
    metodEyebrow: 'Metodologia registrada',
    metodTitle: 'Registro da Metodologia no Ministério da Cultura',
    metodCta: 'Ler o livro da metodologia',
    bookLabel: 'Metodologia IIN',
    bookPh: '[capa do livro]',
    pledgeBtn: 'Leia o compromisso do aluno',
    accountsBtn: 'Prestação de contas',
    ctaTitle: 'Faça parte da próxima página dessa história.',
    sponsor: 'Patrocinar',
  },
  en: {
    home: 'Home',
    crumb: 'About us',
    title: 'About us',
    description: 'Founded by Rodrigo “Minotauro” and Rogério “Minotouro” Nogueira, the Institute uses martial arts as a tool to educate children and young people.',
    eyebrow: 'The Institute · About us',
    heroTitle: 'A story of grit that became a mission.',
    heroLead: 'Founded by MMA champions Rodrigo “Minotauro” and Rogério “Minotouro” Nogueira, the Institute uses martial arts as a tool to educate children and young people.',
    videoLabel: 'Video: meet Instituto Irmãos Nogueira',
    foundersEyebrow: 'The minds behind the project',
    foundersTitle: 'The Nogueira Brothers',
    foundersLead: 'Antônio Rodrigo Nogueira, “Minotauro,” and Antônio Rogério Correia Nogueira, “Minotouro,” created the Institute to give children and young people the same foundation that shaped them: grit, discipline and resilience.',
    founderAlt: (nome: string, apelido: string) => `${nome}, known as ${apelido}`,
    photoPh: '[confirm photo]',
    founderRole: 'Co-founder',
    cv: 'Career highlights',
    tlEyebrow: 'Our journey',
    tlTitle: 'From volunteer work to thousands of students.',
    tlSub: 'Every chapter was made possible by Brazil’s tax-incentive laws and by companies that believed in the project.',
    movesTitle: 'What drives us',
    quote: '“Grit, discipline and resilience have always been part of the Nogueira brothers’ lives.”',
    valores: ['Grit', 'Discipline', 'Resilience'],
    metodEyebrow: 'Registered methodology',
    metodTitle: 'Our methodology, registered with Brazil’s Ministry of Culture',
    metodCta: 'Read the methodology book',
    bookLabel: 'IIN Methodology',
    bookPh: '[book cover]',
    pledgeBtn: 'Read the student pledge',
    accountsBtn: 'Financial reports',
    ctaTitle: 'Help write the next chapter of this story.',
    sponsor: 'Sponsor us',
  },
  es: {
    home: 'Inicio',
    crumb: 'Quiénes somos',
    title: 'Quiénes somos',
    description: 'Fundado por Rodrigo “Minotauro” y Rogério “Minotouro” Nogueira, el Instituto usa las artes marciales como herramienta de educación para niños y jóvenes.',
    eyebrow: 'El Instituto · Quiénes somos',
    heroTitle: 'Una historia de superación que se volvió misión.',
    heroLead: 'Fundado por los campeones de MMA Rodrigo “Minotauro” y Rogério “Minotouro” Nogueira, el Instituto usa las artes marciales como herramienta de educación para niños y jóvenes.',
    videoLabel: 'Video: conoce el Instituto Irmãos Nogueira',
    foundersEyebrow: 'Los creadores del proyecto',
    foundersTitle: 'Los hermanos Nogueira',
    foundersLead: 'Antônio Rodrigo Nogueira, el Minotauro, y Antônio Rogério Correia Nogueira, el Minotouro, crearon el Instituto para darles a niños y jóvenes la misma base que los formó a ellos: superación, disciplina y resiliencia.',
    founderAlt: (nome: string, apelido: string) => `${nome}, el ${apelido}`,
    photoPh: '[confirmar foto]',
    founderRole: 'Cofundador',
    cv: 'Trayectoria',
    tlEyebrow: 'Nuestra trayectoria',
    tlTitle: 'Del trabajo voluntario a miles de alumnos.',
    tlSub: 'Cada etapa fue posible gracias a las leyes de incentivo fiscal de Brasil y a empresas que creyeron en el proyecto.',
    movesTitle: 'Lo que nos mueve',
    quote: '“La superación, la disciplina y la resiliencia siempre han estado presentes en la vida de los hermanos Nogueira.”',
    valores: ['Superación', 'Disciplina', 'Resiliencia'],
    metodEyebrow: 'Metodología registrada',
    metodTitle: 'Metodología registrada ante el Ministerio de Cultura de Brasil',
    metodCta: 'Lee el libro de la metodología',
    bookLabel: 'Metodología IIN',
    bookPh: '[portada del libro]',
    pledgeBtn: 'Lee el compromiso del alumno',
    accountsBtn: 'Rendición de cuentas',
    ctaTitle: 'Sé parte del próximo capítulo de esta historia.',
    sponsor: 'Patrocinar',
  },
};
const T = COPY[lang];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: T.home, item: new URL(l('/'), SITE.url).href },
    { '@type': 'ListItem', position: 2, name: T.crumb, item: new URL(l('/quem-somos/'), SITE.url).href },
  ],
};
---
<BaseLayout
  title={T.title}
  description={T.description}
  jsonLd={[breadcrumb]}
>
  <PageHero
    eyebrow={T.eyebrow}
    title={T.heroTitle}
    lead={T.heroLead}
  >
    <div class="container qs-video">
      <div class="video-frame qs-video__frame">
        <video
          controls
          preload="none"
          playsinline
          poster="/media/poster-quem-somos.webp"
          aria-label={T.videoLabel}
          data-track="video_play"
          data-track-source="quem-somos"
        >
          <source src="/media/video-quem-somos.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </PageHero>

  <section class="section">
    <div class="container stack qs-gap-48">
      <div class="section-head">
        <p class="eyebrow">{T.foundersEyebrow}</p>
        <h2 class="display h2">{T.foundersTitle}</h2>
        <p class="lead">{T.foundersLead}</p>
      </div>
      <div class="grid-auto" style="--min:480px; --gap:32px">
        {FUNDADORES.map((f) => (
          <article class="card card-h chamfer founder">
            <div class="founder__media">
              <div class="oct founder__oct" aria-hidden="true"></div>
              <Image
                src={f.foto}
                alt={T.founderAlt(f.nome, f.apelido)}
                widths={[320, 480, 640]}
                sizes="(max-width: 700px) 100vw, (max-width: 1280px) 50vw, 320px"
                loading="lazy"
                class="founder__img"
              />
              <span class="ph founder__ph">{T.photoPh}</span>
            </div>
            <div class="founder__body">
              <p class="founder__nick">{f.apelido} · {T.founderRole}</p>
              <h3 class="display founder__name">{f.nome}</h3>
              <p class="founder__bio">{f.bio}</p>
              <p class="founder__cv-title">{T.cv}</p>
              <ul class="founder__cv">
                {f.cv.map((c) => <li><span class="oct founder__dot" aria-hidden="true"></span><span>{c}</span></li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container grid-auto" style="--min:320px; --gap:56px">
      <div class="section-head qs-head">
        <p class="eyebrow">{T.tlEyebrow}</p>
        <h2 class="display h2">{T.tlTitle}</h2>
        <p class="qs-sub">{T.tlSub}</p>
      </div>
      <ol class="tl">
        {TIMELINE.map((t) => (
          <li class="tl__item">
            <span class="oct tl__mark" aria-hidden="true"></span>
            <span class="display tl__year">{t.ano}</span>
            <span class="tl__title">{t.titulo}</span>
            <span class="tl__txt">{t.txt}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container stack qs-gap-40">
      <h2 class="display h2">{T.movesTitle}</h2>
      <p class="qs-quote">{T.quote}</p>
      <ul class="grid-auto" style="--min:280px">
        {T.valores.map((v) => (
          <li class="card-h chamfer valor"><span class="display valor__t">{v}</span></li>
        ))}
      </ul>

      <a class="card-h chamfer metod" href={SITE.links.metodologia} target="_blank" rel="noopener">
        <div class="metod__body">
          <p class="eyebrow">{T.metodEyebrow}</p>
          <h3 class="display metod__title">{T.metodTitle}</h3>
          <span class="metod__cta">{T.metodCta}<Icon name="arrow" size={18} /><span class="sr-only">{ui.newTab}</span></span>
        </div>
        <div class="metod__media" aria-hidden="true">
          <div class="metod__book">
            <span>{T.bookLabel}</span>
            <span class="ph metod__book-ph">{T.bookPh}</span>
          </div>
        </div>
      </a>

      <div class="btn-row">
        <Button href={l('/compromisso/')} variant="dark">{T.pledgeBtn}</Button>
        <Button href={l('/transparencia/')} variant="dark">{T.accountsBtn}</Button>
      </div>
    </div>
  </section>

  <CtaBand tone="red" title={T.ctaTitle}>
    <Button href={l('/doar/')} variant="light-on-red" data-track="donate_click" data-track-source="quem-somos-cta">{ui.donateNow}</Button>
    <Button href={l('/empresas/')} variant="light-on-red" data-track="sponsor_click" data-track-source="quem-somos-cta">{T.sponsor}</Button>
  </CtaBand>
</BaseLayout>

<style>
  .qs-video { position: relative; margin-top: calc(-1 * clamp(40px, 5vw, 72px)); padding-bottom: clamp(72px, 8vw, 104px); }
  .qs-video__frame { max-width: 1040px; background: #000; }
  .qs-gap-48 { gap: 48px; }
  .qs-gap-40 { gap: 40px; }
  .qs-sub { font-size: 17px; color: var(--text-2); }

  /* Fundadores */
  .founder { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); }
  .founder__media { position: relative; background: var(--ink); min-height: clamp(360px, 60vw, 440px); overflow: hidden; }
  .founder__oct { position: absolute; left: 50%; top: 46%; width: min(300px, 80%); aspect-ratio: 1; transform: translate(-50%, -50%); background: var(--red); }
  .founder__oct::after { content: ""; position: absolute; inset: 3px; clip-path: var(--oct); background: #1f1f1f; }
  .founder__media :global(.founder__img) { position: absolute; inset: auto 0 0 0; width: 100%; height: 92%; object-fit: contain; object-position: 50% 100%; }
  .card-h:hover :global(.founder__img) { transform: none; }
  .founder__ph { position: absolute; left: 12px; top: 12px; font-size: 12px; }
  .founder__body { padding: clamp(24px, 4vw, 32px) clamp(20px, 3vw, 28px); display: flex; flex-direction: column; gap: 14px; }
  .founder__nick { font-size: 13px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--red); }
  .founder__name { font-size: clamp(28px, 3vw, 34px); line-height: 1; }
  .founder__bio { font-size: 15.5px; color: var(--text-2); }
  .founder__cv-title { font-size: 12px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; padding-top: 8px; border-top: 1px solid var(--line-2); }
  .founder__cv { display: flex; flex-direction: column; gap: 8px; font-size: 16px; }
  .founder__cv li { display: flex; gap: 10px; align-items: flex-start; font-size: 16px; line-height: 1.5; color: #2a2a2a; }
  .founder__dot { flex: none; margin-top: 6px; width: 8px; height: 8px; background: var(--red); }

  /* Linha do tempo */
  .qs-head { max-width: none; }
  .tl { border-left: 3px solid var(--ink); }
  .tl__item { position: relative; padding: 0 0 40px 36px; display: flex; flex-direction: column; gap: 8px; }
  .tl__item:last-child { padding-bottom: 0; }
  .tl__mark { position: absolute; left: -11px; top: 8px; width: 19px; height: 19px; background: var(--red); }
  .tl__year { font-size: 40px; line-height: 1; }
  .tl__title { font-weight: 800; font-size: 17px; }
  .tl__txt { font-size: 15.5px; color: var(--text-2); text-wrap: pretty; }

  /* O que nos move */
  .qs-quote { max-width: 820px; font-size: clamp(19px, 2vw, 22px); line-height: 1.45; font-weight: 600; }
  .valor { background: var(--ink); color: #fff; padding: 40px 30px; display: flex; align-items: center; justify-content: center; min-height: 150px; }
  .valor__t { font-size: clamp(38px, 4vw, 48px); line-height: 1; color: var(--red-lt); }

  .metod { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); text-decoration: none; color: var(--ink); background: var(--white); border: 2px solid var(--ink); }
  .metod:hover { color: var(--ink); }
  .metod__body { padding: clamp(24px, 4vw, 36px); display: flex; flex-direction: column; gap: 12px; }
  .metod__title { font-size: clamp(30px, 3.2vw, 38px); line-height: 0.95; }
  .metod__cta { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; color: var(--red); }
  .metod__media { background: var(--ink); min-height: 220px; display: flex; align-items: center; justify-content: center; padding: 24px; }
  .metod__book { width: 150px; height: 200px; background: var(--red); box-shadow: 14px 14px 0 #3a3a3a; display: flex; flex-direction: column; justify-content: space-between; padding: 16px; color: #fff; font-family: var(--font-display); font-weight: 800; text-transform: uppercase; line-height: 1; font-size: 14px; }
  .metod__book-ph { align-self: flex-start; font-family: var(--font-body); text-transform: none; font-size: 12px; }
</style>
