---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../data/site';
import { getContent } from '../data/content';
import { i18n } from '../i18n/config';
import { t } from '../i18n/ui';

const { lang, l } = i18n(Astro.url);
const ui = t(lang);
const { PRINCIPIOS, COMPROMISSOS } = getContent(lang);

// Só conteúdo já publicado pelo Instituto (Quem somos, Compromisso e o registro no Ministério da Cultura).
const COPY = {
  pt: {
    home: 'Início',
    crumb: 'Metodologia',
    title: 'Metodologia',
    description: 'A metodologia do Instituto Irmãos Nogueira, registrada no Ministério da Cultura: artes marciais como ferramenta de educação, com 6 princípios e um compromisso assumido por todo aluno.',
    eyebrow: 'Metodologia',
    heroTitle: 'Arte marcial como <span class="accent">ferramenta de educação</span>.',
    heroLead: 'Uma metodologia própria, registrada no Ministério da Cultura, que leva para crianças e jovens a mesma base que formou os Irmãos Nogueira.',
    readBook: 'Ler o livro da metodologia',
    findCenter: 'Encontre um núcleo',
    baseEyebrow: 'A base',
    baseTitle: 'O que nos move',
    quote: '“Superação, disciplina e resiliência sempre estiveram presentes na vida dos Irmãos Nogueira.”',
    valores: ['Superação', 'Disciplina', 'Resiliência'],
    princEyebrow: 'No tatame',
    princTitle: 'Os 6 princípios da faixa preta',
    princLead: 'Todo aluno se compromete a usar a arte marcial apenas para o bem, de forma defensiva e positiva, para ajudar a si mesmo e aos outros.',
    pledgeEyebrow: 'Antes da primeira técnica',
    pledgeTitle: 'Compromisso do aluno',
    pledgeIntro: 'Ao vestir o quimono do Instituto Irmãos Nogueira, eu me comprometo a:',
    pledgeMore: 'Ler o compromisso completo',
    bookEyebrow: 'Metodologia registrada',
    bookTitle: 'Registro da Metodologia no Ministério da Cultura',
    bookLead: 'O livro digital com a metodologia do Instituto está disponível na plataforma EAD.',
    bookLabel: 'Metodologia IIN',
    ctaTitle: 'Quer que seu filho viva esses princípios?',
  },
  en: {
    home: 'Home',
    crumb: 'Methodology',
    title: 'Methodology',
    description: 'The Instituto Irmãos Nogueira methodology, registered with Brazil’s Ministry of Culture: martial arts as a tool for education, with 6 principles and a pledge every student makes.',
    eyebrow: 'Methodology',
    heroTitle: 'Martial arts as a <span class="accent">tool for education</span>.',
    heroLead: 'Our own methodology, registered with Brazil’s Ministry of Culture, passing on to children and teens the same foundation that shaped the Nogueira brothers.',
    readBook: 'Read the methodology book',
    findCenter: 'Find a center',
    baseEyebrow: 'The foundation',
    baseTitle: 'What drives us',
    quote: '“Grit, discipline and resilience have always been part of the Nogueira brothers’ lives.”',
    valores: ['Grit', 'Discipline', 'Resilience'],
    princEyebrow: 'On the mat',
    princTitle: 'The 6 black belt principles',
    princLead: 'Every student pledges to use martial arts only for good, defensively and positively, to help themselves and others.',
    pledgeEyebrow: 'Before the first technique',
    pledgeTitle: 'Student pledge',
    pledgeIntro: 'When I put on the Instituto Irmãos Nogueira gi, I pledge:',
    pledgeMore: 'Read the full pledge',
    bookEyebrow: 'Registered methodology',
    bookTitle: 'Our methodology, registered with Brazil’s Ministry of Culture',
    bookLead: 'The digital book with the Institute’s methodology is available on our online platform (in Portuguese).',
    bookLabel: 'IIN Methodology',
    ctaTitle: 'Want your child to live by these principles?',
  },
  es: {
    home: 'Inicio',
    crumb: 'Metodología',
    title: 'Metodología',
    description: 'La metodología del Instituto Irmãos Nogueira, registrada ante el Ministerio de Cultura de Brasil: artes marciales como herramienta educativa, con 6 principios y un compromiso que asume cada alumno.',
    eyebrow: 'Metodología',
    heroTitle: 'El arte marcial como <span class="accent">herramienta educativa</span>.',
    heroLead: 'Una metodología propia, registrada ante el Ministerio de Cultura de Brasil, que transmite a niños y jóvenes la misma base que formó a los hermanos Nogueira.',
    readBook: 'Lee el libro de la metodología',
    findCenter: 'Encuentra un centro',
    baseEyebrow: 'La base',
    baseTitle: 'Lo que nos mueve',
    quote: '“La superación, la disciplina y la resiliencia siempre han estado presentes en la vida de los hermanos Nogueira.”',
    valores: ['Superación', 'Disciplina', 'Resiliencia'],
    princEyebrow: 'En el tatami',
    princTitle: 'Los 6 principios del cinturón negro',
    princLead: 'Cada alumno se compromete a usar el arte marcial solo para el bien, de forma defensiva y positiva, para ayudarse a sí mismo y a los demás.',
    pledgeEyebrow: 'Antes de la primera técnica',
    pledgeTitle: 'Compromiso del alumno',
    pledgeIntro: 'Al ponerme el kimono del Instituto Irmãos Nogueira, me comprometo a:',
    pledgeMore: 'Lee el compromiso completo',
    bookEyebrow: 'Metodología registrada',
    bookTitle: 'Metodología registrada ante el Ministerio de Cultura de Brasil',
    bookLead: 'El libro digital con la metodología del Instituto está disponible en nuestra plataforma en línea (en portugués).',
    bookLabel: 'Metodología IIN',
    ctaTitle: '¿Quieres que tu hijo viva estos principios?',
  },
};
const T = COPY[lang];
const pad = (i: number) => String(i + 1).padStart(2, '0');

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: T.home, item: new URL(l('/'), SITE.url).href },
    { '@type': 'ListItem', position: 2, name: T.crumb, item: new URL(l('/metodologia/'), SITE.url).href },
  ],
};
---
<BaseLayout title={T.title} description={T.description} jsonLd={[breadcrumb]}>
  <PageHero eyebrow={T.eyebrow} title={T.heroTitle} lead={T.heroLead}>
    <Fragment slot="actions">
      <Button href={SITE.links.metodologia} external>{T.readBook}</Button>
      <Button href={l('/nucleos/')} variant="ghost" data-track="signup_click" data-track-source="metodologia-hero">{T.findCenter}</Button>
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="container stack mt-gap">
      <div class="section-head">
        <p class="eyebrow">{T.baseEyebrow}</p>
        <h2 class="display h2">{T.baseTitle}</h2>
        <p class="mt-quote">{T.quote}</p>
      </div>
      <ul class="mt-vals">
        {T.valores.map((v, i) => (
          <li class="mt-val chamfer card-h">
            <span class="mt-val__n" aria-hidden="true">{pad(i)}</span>
            <span class="display mt-val__t">{v}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container stack mt-gap">
      <div class="section-head">
        <p class="eyebrow">{T.princEyebrow}</p>
        <h2 class="display h2">{T.princTitle}</h2>
        <p class="lead">{T.princLead}</p>
      </div>
      <ol class="mt-princ">
        {PRINCIPIOS.map((p, i) => (
          <li class="mt-princ__item card-h">
            <span class="oct-badge oct-badge--red" aria-hidden="true">{pad(i)}</span>
            <span class="display mt-princ__t">{p}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container mt-pledge">
      <div class="stack mt-pledge__head">
        <p class="eyebrow">{T.pledgeEyebrow}</p>
        <h2 class="display h2">{T.pledgeTitle}</h2>
        <p class="lead">{T.pledgeIntro}</p>
        <a class="lnk" href={l('/compromisso/')}>{T.pledgeMore}<Icon name="arrow" /></a>
      </div>
      <ol class="mt-pledge__list">
        {COMPROMISSOS.slice(0, 4).map((c, i) => (
          <li><span class="display mt-pledge__n" aria-hidden="true">{i + 1}</span><span>{c}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--dark clip">
    <div class="container">
      <a class="mt-book" href={SITE.links.metodologia} target="_blank" rel="noopener">
        <div class="mt-book__cover" aria-hidden="true">
          <Logo size={44} variant="dark" wordmark={false} />
          <span>{T.bookLabel}</span>
        </div>
        <div class="stack mt-book__body">
          <p class="eyebrow">{T.bookEyebrow}</p>
          <h2 class="display mt-book__title">{T.bookTitle}</h2>
          <p class="lead">{T.bookLead}</p>
          <span class="lnk lnk--light">{T.readBook}<Icon name="external" size={18} /><span class="sr-only">{ui.newTab}</span></span>
        </div>
      </a>
    </div>
  </section>

  <CtaBand tone="red" title={T.ctaTitle}>
    <Button href={l('/nucleos/')} variant="light-on-red" data-track="signup_click" data-track-source="metodologia-cta">{T.findCenter}</Button>
  </CtaBand>
</BaseLayout>

<style>
  .mt-gap { gap: clamp(32px, 4vw, 48px); }
  .mt-quote { max-width: 820px; font-size: clamp(19px, 2vw, 22px); line-height: 1.45; font-weight: 600; }

  .mt-vals { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 12px; }
  .mt-val { position: relative; display: flex; flex-direction: column; justify-content: space-between; gap: 40px; min-height: 180px; padding: clamp(24px, 3vw, 32px); background: var(--ink); color: #fff; }
  .mt-val__n { font-size: 13px; font-weight: 800; letter-spacing: 0.14em; color: #8a8a8a; }
  .mt-val__t { font-size: clamp(36px, 4vw, 48px); line-height: 1; color: var(--red-lt); }

  .mt-princ { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 12px; }
  .mt-princ__item { display: flex; align-items: center; gap: 20px; padding: 22px 24px; background: var(--white); }
  .mt-princ__t { font-size: clamp(24px, 2.6vw, 32px); line-height: 1; }

  .mt-pledge { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .mt-pledge__head { gap: 18px; align-items: flex-start; }
  .mt-pledge__list { display: flex; flex-direction: column; border-top: 2px solid var(--ink); }
  .mt-pledge__list li { display: flex; gap: 20px; align-items: flex-start; padding: 20px 0; border-bottom: 1px solid var(--line-2); font-size: clamp(16px, 1.6vw, 18px); color: #2a2a2a; }
  .mt-pledge__n { flex: none; width: 28px; font-size: 30px; line-height: 1; color: var(--red); }

  .mt-book { display: grid; grid-template-columns: auto 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; text-decoration: none; color: #fff; }
  .mt-book:hover { color: #fff; }
  .mt-book__cover { width: clamp(150px, 18vw, 210px); aspect-ratio: 3 / 4; display: flex; flex-direction: column; justify-content: space-between; padding: 20px; background: var(--red); box-shadow: 16px 16px 0 #2e2e2e; font-family: var(--font-display); font-weight: 800; font-size: 18px; line-height: 1; text-transform: uppercase; transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out); }
  .mt-book:hover .mt-book__cover { transform: translate(-6px, -6px) rotate(-1.5deg); box-shadow: 24px 24px 0 #2e2e2e; }
  .mt-book__body { gap: 16px; align-items: flex-start; }
  .mt-book__title { font-size: clamp(32px, 3.6vw, 48px); line-height: 0.95; max-width: 720px; }
  .mt-book:hover .lnk { background-size: calc(100% - 26px) 2px; }
  @media (max-width: 640px) {
    .mt-book { grid-template-columns: 1fr; }
    .mt-val { min-height: 0; gap: 18px; }
  }
</style>
