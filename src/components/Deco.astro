---
/** Decorações de fundo: anéis de octógono e granulação. Puramente visuais (aria-hidden). */
interface Props {
  rings?: 'light' | 'dark' | 'red' | false;
  grain?: 'light' | 'dark' | false;
  ringsStyle?: string;
}
const { rings = false, grain = false, ringsStyle = 'right:-14%;top:-40%;width:70%;height:180%' } = Astro.props;
const stroke = rings === 'light' ? 'rgba(200,32,26,0.16)' : rings === 'red' ? 'rgba(255,255,255,0.14)' : 'rgba(255,255,255,0.10)';
const id = `gr-${Math.random().toString(36).slice(2, 8)}`;
// Tamanho depende só da LARGURA (aspect-ratio) e o topo é ancorado em vw: assim a troca de fonte
// (que muda a altura da seção) não desloca o desenho — evita CLS.
const rules = Object.fromEntries(ringsStyle.split(';').filter(Boolean).map((r) => r.split(':').map((s) => s.trim())));
const side = rules.left !== undefined ? `left:${rules.left}` : `right:${rules.right ?? '-14%'}`;
const svgStyle = `${side};width:${rules.width ?? '70%'};top:-12vw;height:auto;aspect-ratio:1/1`;
---
{rings && (
  <svg class="deco" aria-hidden="true" viewBox="0 0 1000 1000" style={svgStyle}>
    <g fill="none" stroke={stroke} stroke-width="1.2">
      <polygon points="353,0 647,0 1000,353 1000,647 647,1000 353,1000 0,647 0,353" />
      <polygon points="388,85 612,85 915,388 915,612 612,915 388,915 85,612 85,388" />
      <polygon points="423,170 577,170 830,423 830,577 577,830 423,830 170,577 170,423" />
      <polygon points="458,255 542,255 745,458 745,542 542,745 458,745 255,542 255,458" />
    </g>
  </svg>
)}
{grain && (
  <svg class:list={['grain', grain === 'light' && 'grain--light']} aria-hidden="true">
    <filter id={id}><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" stitchTiles="stitch" /></filter>
    <rect width="100%" height="100%" filter={`url(#${id})`} />
  </svg>
)}
