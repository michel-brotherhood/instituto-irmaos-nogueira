---
/**
 * Intro com o logo 3D — 1x por sessão, só na primeira página aberta.
 * - O <head> decide (script inline em BaseLayout) se mostra: sem flash nas páginas seguintes.
 * - Mínimo ~0,9 s (a animação completa) e máximo 2,2 s, mesmo que a página demore a carregar.
 * - Sem JS ou com prefers-reduced-motion: não aparece.
 */
---
<div class="intro" aria-hidden="true">
  <div class="intro__stage">
    <img class="intro__logo" src="/media/logo-intro.webp" width="440" height="452" alt="" fetchpriority="high" decoding="async" />
    <span class="intro__bar"><span></span></span>
  </div>
</div>

<script is:inline>
  (function () {
    var html = document.documentElement;
    if (!html.classList.contains('intro-on')) return;
    var t0 = performance.now(), ended = false;
    function end() {
      if (ended) return; ended = true;
      setTimeout(function () {
        html.classList.add('intro-out');
        setTimeout(function () { html.classList.remove('intro-on', 'intro-out'); }, 520);
      }, Math.max(0, 900 - (performance.now() - t0)));
    }
    if (document.readyState === 'complete') end();
    else window.addEventListener('load', end, { once: true });
    setTimeout(end, 2200);
  })();
</script>

<style is:global>
  .intro { display: none; }
  .intro-on body { overflow: hidden; }
  .intro-on .intro {
    position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center;
    background: radial-gradient(60% 55% at 50% 46%, #26242c 0%, #0c0b0f 70%);
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s 0.5s;
  }
  .intro__stage { display: flex; flex-direction: column; align-items: center; gap: 28px; perspective: 900px; }
  .intro__logo {
    width: clamp(132px, 22vw, 200px); height: auto;
    filter: drop-shadow(0 26px 36px rgba(0, 0, 0, 0.55)) drop-shadow(0 0 40px rgba(200, 32, 26, 0.18));
    animation: intro-in 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .intro__bar { width: 120px; height: 3px; background: rgba(255, 255, 255, 0.12); overflow: hidden; }
  .intro__bar span { display: block; height: 100%; background: var(--red, #c8201a); transform-origin: left; animation: intro-bar 1.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .intro-out .intro { opacity: 0; visibility: hidden; }
  .intro-out .intro__logo { animation: intro-zoom 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards; }

  @keyframes intro-in {
    from { opacity: 0; transform: rotateY(-38deg) rotateX(10deg) scale(0.82); }
    to { opacity: 1; transform: none; }
  }
  @keyframes intro-zoom { to { transform: scale(1.1); opacity: 0; } }
  @keyframes intro-bar { from { transform: scaleX(0); } to { transform: scaleX(1); } }
</style>
