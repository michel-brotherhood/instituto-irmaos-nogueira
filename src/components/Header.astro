---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { navFor } from '../data/site';
import { LANGS, LANG_META, getLang, stripLang, localizePath } from '../i18n/config';
import { t } from '../i18n/ui';

const lang = getLang(Astro.url);
const ui = t(lang);
const NAV = navFor(lang);
const l = (p: string) => localizePath(p, lang);
const path = Astro.url.pathname;
// A 404 não tem tradução por rota: o seletor leva à home de cada idioma
const basePath = path.startsWith('/404') ? '/' : stripLang(path);
const isActive = (item: { href: string; match?: string[]; children?: { href: string }[] }) =>
  path === item.href || (item.match ?? []).includes(path) || (item.children ?? []).some((c) => path === c.href);
const ext = { target: '_blank', rel: 'noopener' };
// Mesmo conteúdo nos outros idiomas
const langs = LANGS.map((code) => ({ code, ...LANG_META[code], href: localizePath(basePath, code), current: code === lang }));
---
<header class="hdr" data-header>
  {/* Faixa de sugestão: aparece só quando o idioma do navegador ≠ idioma da página (decidido no <head>, sem salto de layout) */}
  {langs.filter((x) => !x.current).map((x) => (
    <div class="langbar" data-for={x.code} lang={x.html}>
      <div class="container langbar__in">
        <Icon name="globe" size={18} />
        <p>{t(x.code).lang.suggest}</p>
        <a href={x.href} hreflang={x.html} class="langbar__go" data-lang-pick={x.code}>{t(x.code).lang.switch}</a>
        <button type="button" class="langbar__x" aria-label={t(x.code).lang.dismiss} data-langbar-close><Icon name="close" size={18} /></button>
      </div>
    </div>
  ))}

  <div class="container hdr__in">
    <a href={l('/')} class="hdr__brand"><Logo /><span class="sr-only"> — {ui.home}</span></a>

    <nav class="hdr__nav" aria-label={ui.navMain}>
      <ul class="hdr__list">
        {NAV.map((item) => (
          <li class:list={['hdr__item', item.children && 'hdr__item--dd']}>
            <a href={item.href} class="hdr__link" aria-current={isActive(item) ? 'page' : undefined} {...(item.external ? ext : {})}>
              {item.label}
              {item.children && <Icon name="chevron" size={14} strokeWidth={2.5} />}
              {item.external && <Icon name="external" size={13} strokeWidth={2.4} class="hdr__ext" />}
              {item.external && <span class="sr-only">{ui.newTab}</span>}
            </a>
            {item.children && (
              <ul class="hdr__dd">
                {item.children.map((c) => (
                  <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__actions">
      <div class="lang" data-lang>
        <button type="button" class="lang__btn" aria-expanded="false" aria-controls="lang-menu" aria-label={`${ui.lang.label}: ${LANG_META[lang].label}`} data-lang-toggle>
          <Icon name="globe" size={18} />
          <span>{LANG_META[lang].short}</span>
          <Icon name="chevron" size={14} strokeWidth={2.5} />
        </button>
        <ul id="lang-menu" class="lang__menu" hidden aria-label={ui.lang.choose}>
          {langs.map((x) => (
            <li>
              <a href={x.href} hreflang={x.html} lang={x.html} aria-current={x.current ? 'true' : undefined} data-lang-pick={x.code}>
                <span class="lang__code">{x.short}</span>{x.label}
                {x.current && <Icon name="check" size={16} strokeWidth={2.5} />}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <Button href={l('/doar/')} size="sm" class="hdr__donate"><span class="hdr__dl">{ui.donateNow}</span><span class="hdr__ds">{ui.donate}</span></Button>
      <button class="hdr__burger" type="button" aria-label={ui.openMenu} aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <Icon name="menu" size={22} strokeWidth={2} />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mnav" hidden data-menu role="dialog" aria-modal="true" aria-label={ui.menu}>
    <div class="container mnav__top">
      <a href={l('/')} class="hdr__brand"><Logo variant="dark" /><span class="sr-only"> — {ui.home}</span></a>
      <button class="mnav__close" type="button" aria-label={ui.closeMenu} data-menu-close>
        <Icon name="close" size={24} strokeWidth={2.2} />
      </button>
    </div>
    <nav aria-label={ui.navMobile} class="container mnav__body">
      <ul class="mnav__list">
        {NAV.map((item) => (
          <li>
            <a href={item.href} class="mnav__main" aria-current={isActive(item) ? 'page' : undefined} {...(item.external ? ext : {})}>
              {item.label}
              {item.external && <Icon name="external" size={18} strokeWidth={2.4} class="mnav__ext" />}
              {item.external && <span class="sr-only">{ui.newTab}</span>}
            </a>
            {item.children && (
              <ul class="mnav__sub">
                {item.children.map((c) => <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <div class="mnav__foot">
        <ul class="mnav__langs" aria-label={ui.lang.choose}>
          {langs.map((x) => (
            <li><a href={x.href} hreflang={x.html} lang={x.html} aria-current={x.current ? 'true' : undefined} data-lang-pick={x.code} aria-label={x.label}>{x.short}</a></li>
          ))}
        </ul>
        <Button href={l('/doar/')} block data-track="donate_click" data-track-source="mobile_menu">{ui.donateNow}</Button>
      </div>
    </nav>
  </div>
</header>

<script>
  // ---------- Menu móvel ----------
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const close = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  if (toggle && menu && close) {
    const focusables = () => Array.from(menu.querySelectorAll<HTMLElement>('a[href], button'));
    const set = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      // Tela cheia e sem rolagem da página por trás
      document.documentElement.classList.toggle('menu-open', open);
      if (open) close.focus(); else toggle.focus();
    };
    toggle.addEventListener('click', () => set(true));
    close.addEventListener('click', () => set(false));
    document.addEventListener('keydown', (e) => {
      if (menu.hidden) return;
      if (e.key === 'Escape') set(false);
      if (e.key === 'Tab') {
        // Mantém o foco dentro do menu
        const f = focusables(); const first = f[0]; const last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) { menu.hidden = true; document.documentElement.classList.remove('menu-open'); toggle.setAttribute('aria-expanded', 'false'); } });
    // Se a tela crescer para desktop com o menu aberto, fecha
    matchMedia('(min-width: 1100px)').addEventListener('change', (m) => { if (m.matches && !menu.hidden) set(false); });
  }

  // ---------- Seletor de idioma (desktop) ----------
  const lang = document.querySelector<HTMLElement>('[data-lang]');
  const lbtn = lang?.querySelector<HTMLButtonElement>('[data-lang-toggle]');
  const lmenu = lang?.querySelector<HTMLElement>('#lang-menu');
  if (lang && lbtn && lmenu) {
    const setL = (open: boolean, focus = false) => {
      lmenu.hidden = !open;
      lbtn.setAttribute('aria-expanded', String(open));
      if (open && focus) lmenu.querySelector<HTMLElement>('a')?.focus();
    };
    lbtn.addEventListener('click', () => setL(lmenu.hidden));
    lbtn.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown') { e.preventDefault(); setL(true, true); } });
    lmenu.addEventListener('keydown', (e) => {
      const items = Array.from(lmenu.querySelectorAll<HTMLAnchorElement>('a'));
      const i = items.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'ArrowDown') { e.preventDefault(); items[(i + 1) % items.length].focus(); }
      if (e.key === 'ArrowUp') { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
      if (e.key === 'Escape') { setL(false); lbtn.focus(); }
    });
    document.addEventListener('click', (e) => { if (!lang.contains(e.target as Node)) setL(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lmenu.hidden) { setL(false); lbtn.focus(); } });
    lang.addEventListener('focusout', (e) => { if (!lang.contains(e.relatedTarget as Node)) setL(false); });
  }

  // ---------- Preferência de idioma ----------
  // Qualquer escolha explícita é lembrada: a faixa de sugestão não volta a aparecer.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-pick]').forEach((a) =>
    a.addEventListener('click', () => { try { localStorage.setItem('iin-lang', a.dataset.langPick ?? ''); } catch {} })
  );
  document.querySelectorAll<HTMLButtonElement>('[data-langbar-close]').forEach((b) =>
    b.addEventListener('click', () => {
      try { localStorage.setItem('iin-langbar', '1'); } catch {}
      document.documentElement.className = document.documentElement.className.replace(/\blangbar-\w+\b/g, '').trim();
    })
  );
</script>

<style>
  .hdr { position: relative; z-index: 50; background: var(--bg); border-bottom: 1px solid var(--line-2); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: var(--header-h); }
  .hdr__brand { text-decoration: none; }
  .hdr__list { display: flex; align-items: center; gap: clamp(16px, 2vw, 30px); font-weight: 600; font-size: 15px; }
  .hdr__item { position: relative; }
  .hdr__link { position: relative; display: flex; align-items: center; gap: 6px; padding: 10px 0; text-decoration: none; white-space: nowrap; }
  .hdr__link::after { content: ""; position: absolute; left: 0; right: 100%; bottom: 4px; height: 2px; background: var(--red); transition: right 0.3s var(--ease); }
  .hdr__link:hover::after, .hdr__link[aria-current='page']::after { right: 0; }
  .hdr__link[aria-current='page'] { color: var(--red); }
  .hdr__link :global(.hdr__ext) { opacity: 0.55; }
  .hdr__dd { position: absolute; top: 100%; left: -18px; display: none; flex-direction: column; min-width: 230px; padding: 10px; background: #fff; border: 1px solid var(--line-2); box-shadow: 0 18px 40px rgba(20, 20, 20, 0.12); }
  .hdr__dd a { display: block; padding: 10px 12px; text-decoration: none; }
  .hdr__dd a[aria-current='page'] { color: var(--red); }
  .hdr__item--dd:hover .hdr__dd, .hdr__item--dd:focus-within .hdr__dd { display: flex; }
  .hdr__actions { display: flex; align-items: center; gap: 10px; }
  .hdr__ds { display: none; }
  .hdr__burger { display: none; width: 46px; height: 46px; align-items: center; justify-content: center; background: var(--ink); color: #fff; border: 0; cursor: pointer; }

  /* Seletor de idioma: discreto (globo + sigla), lista com o nome nativo de cada idioma */
  .lang { position: relative; }
  .lang__btn { display: inline-flex; align-items: center; gap: 6px; min-height: 46px; padding: 0 12px; background: transparent; border: 1px solid var(--line-2); color: var(--ink); font: 700 14px/1 var(--font-body); letter-spacing: 0.04em; cursor: pointer; transition: border-color 0.2s, background-color 0.2s; }
  .lang__btn:hover, .lang__btn[aria-expanded='true'] { border-color: var(--ink); background: #fff; }
  .lang__btn :global(svg:last-child) { transition: transform 0.2s var(--ease); }
  .lang__btn[aria-expanded='true'] :global(svg:last-child) { transform: rotate(180deg); }
  .lang__menu { position: absolute; right: 0; top: calc(100% + 8px); z-index: 60; min-width: 200px; padding: 6px; background: #fff; border: 1px solid var(--line-2); box-shadow: 0 18px 40px rgba(20, 20, 20, 0.14); }
  .lang__menu[hidden] { display: none; }
  .lang__menu a { display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 0 12px; text-decoration: none; font-weight: 600; }
  .lang__menu a:hover { background: var(--bg); }
  .lang__menu a[aria-current='true'] { color: var(--red-dk); }
  .lang__menu a :global(svg) { margin-left: auto; }
  .lang__code { width: 26px; font-size: 12px; font-weight: 800; letter-spacing: 0.06em; color: var(--text-3); }

  /* Faixa de sugestão de idioma */
  .langbar { display: none; background: var(--ink); color: #fff; font-size: 14px; }
  :global(html.langbar-pt) .langbar[data-for='pt'], :global(html.langbar-en) .langbar[data-for='en'], :global(html.langbar-es) .langbar[data-for='es'] { display: block; }
  .langbar__in { display: flex; align-items: center; gap: 12px; min-height: 48px; }
  .langbar__in p { flex: 1; color: #d6d6d6; }
  .langbar__go { color: #fff; font-weight: 800; text-underline-offset: 4px; white-space: nowrap; min-height: 44px; display: inline-flex; align-items: center; }
  .langbar__x { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; background: none; border: 0; color: #fff; cursor: pointer; }

  /* Menu móvel: tela cheia, sem rolagem — tamanhos escalam com a altura da tela para tudo caber */
  .mnav { position: fixed; inset: 0; z-index: 100; display: flex; flex-direction: column; height: 100dvh; overflow: hidden; overscroll-behavior: contain; background: var(--ink); color: #fff; }
  .mnav[hidden] { display: none; }
  .mnav__top { flex: none; display: flex; align-items: center; justify-content: space-between; min-height: var(--header-h); border-bottom: 1px solid #2a2a2a; }
  .mnav__close { width: 46px; height: 46px; display: inline-flex; align-items: center; justify-content: center; background: var(--red); color: #fff; border: 0; cursor: pointer; }
  .mnav__body { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: space-between; gap: clamp(12px, 3dvh, 28px); padding-block: clamp(8px, 2.5dvh, 28px) calc(clamp(16px, 3dvh, 32px) + env(safe-area-inset-bottom)); }
  .mnav__main { display: block; padding-block: clamp(7px, 1.7dvh, 14px); border-bottom: 1px solid #2e2e2e; color: #fff; text-decoration: none; font-family: var(--font-display); font-weight: 800; font-size: clamp(22px, 4.4dvh, 34px); line-height: 1.05; text-transform: uppercase; }
  .mnav__main { display: flex; align-items: center; gap: 10px; }
  .mnav__main :global(.mnav__ext) { opacity: 0.5; }
  .mnav__main[aria-current='page'], .mnav__sub a[aria-current='page'] { color: var(--red-lt); }
  .mnav__sub { display: flex; flex-wrap: wrap; gap: 0 20px; padding-block: 4px; border-bottom: 1px solid #2e2e2e; }
  .mnav__sub a { display: inline-flex; align-items: center; min-height: clamp(36px, 5.6dvh, 44px); color: #bdbdbd; text-decoration: none; font-weight: 600; font-size: 15px; }
  .mnav__list > li:has(.mnav__sub) > .mnav__main { border-bottom: 0; }
  .mnav__foot { display: flex; flex-direction: column; gap: clamp(10px, 2dvh, 16px); }
  /* Idiomas no menu: controle segmentado, sempre visível, na zona do polegar */
  .mnav__langs { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid #3a3a3a; }
  .mnav__langs a { display: flex; align-items: center; justify-content: center; min-height: 44px; color: #cfcfcf; text-decoration: none; font-weight: 800; font-size: 14px; letter-spacing: 0.08em; }
  .mnav__langs li + li a { border-left: 1px solid #3a3a3a; }
  .mnav__langs a[aria-current='true'] { background: #fff; color: var(--ink); }
  @media (max-height: 520px) and (orientation: landscape) {
    .mnav__list { columns: 2; column-gap: 40px; }
    .mnav__list > li { break-inside: avoid; }
    .mnav__main { font-size: 22px; padding-block: 8px; }
    .mnav__body { overflow-y: auto; }
    .mnav__foot { flex-direction: row; }
    .mnav__langs { flex: none; width: 200px; }
  }
  :global(html.menu-open), :global(html.menu-open body) { overflow: hidden; }

  /* Abaixo de 1100px o menu vai para o botão ☰ (cabe nos 3 idiomas sem quebrar linha) */
  @media (max-width: 1099px) {
    .hdr__nav { display: none; }
    .hdr__burger { display: inline-flex; }
    .lang { display: none; }
  }
  @media (max-width: 520px) {
    .hdr__in { gap: 10px; }
    .hdr__burger { width: 44px; height: 44px; }
    .hdr :global(.hdr__donate .btn__icon) { display: none; }
    .hdr :global(.hdr__donate .btn__label) { padding: 0 14px; }
    .hdr__dl { display: none; }
    .hdr__ds { display: inline; }
    .langbar__in { gap: 8px; font-size: 13px; }
    .langbar__in > :global(svg) { display: none; }
  }
</style>
