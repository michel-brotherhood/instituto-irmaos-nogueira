export type IconName = keyof typeof PATHS;
interface Props { name: IconName; size?: number; strokeWidth?: number; class?: string; label?: string }
const { name, size = 18, strokeWidth = 2.2, class: cls, label } = Astro.props;
const fill = name === 'youtube' ? 'none' : 'none';
---
<svg
  width={size} height={size} viewBox="0 0 24 24" fill={fill} stroke="currentColor"
  stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" class={cls}
  aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}
><path d={PATHS[name]} /></svg>
