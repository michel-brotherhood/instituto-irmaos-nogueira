---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { SITE } from '../data/site';
import { getContent, fmtTel } from '../data/content';
import { i18n } from '../i18n/config';
import { t } from '../i18n/ui';
const { lang, l } = i18n(Astro.url);
const ui = t(lang);
const f = ui.footer;
const { NUCLEOS } = getContent(lang);

const { contact, social } = SITE;
const year = new Date().getFullYear();
// Ordem pedida: Instagram, Facebook, YouTube
const socials = [
  social.instagram && { href: social.instagram, label: 'Instagram', icon: 'instagram' as const },
  social.facebook && { href: social.facebook, label: 'Facebook', icon: 'facebook' as const },
  social.youtube && { href: social.youtube, label: 'YouTube', icon: 'youtube' as const },
].filter(Boolean) as { href: string; label: string; icon: 'instagram' | 'youtube' | 'facebook' }[];
---
<footer class="ftr">
  <div aria-hidden="true" class="outline-word ftr__word">{f.word}</div>
  <div class="container ftr__in">
    <div class="ftr__grid">
      <div class="stack ftr__brand">
        <Logo variant="dark" size={48} />
        <p class="ftr__about">{f.about}</p>
        <div><Button href={l('/doar/')} size="sm" data-track="donate_click" data-track-source="footer">{ui.donateNow}</Button></div>
      </div>

      <nav aria-label={f.institute} class="ftr__col">
        <h2 class="ftr__h">{f.institute}</h2>
        <a class="ftr__a" href={l('/quem-somos/')}>{ui.nav.about}</a>
        <a class="ftr__a" href={l('/metodologia/')}>{ui.nav.method}</a>
        <a class="ftr__a" href={l('/transparencia/')}>{ui.nav.transparency}</a>
      </nav>

      <nav aria-label={f.centers} class="ftr__col">
        <h2 class="ftr__h">{f.centers}</h2>
        <ul class="ftr__nuc">
          {NUCLEOS.map((n) => <li><a class="ftr__a" href={l(`/nucleos/#${n.slug}`)}>{n.nome}</a></li>)}
        </ul>
        <a class="ftr__a ftr__more" href={l('/nucleos/')}>{f.allCenters}<Icon name="arrow" size={14} /></a>
      </nav>

      <div class="ftr__col">
        <h2 class="ftr__h">{f.contact}</h2>
        <a class="ftr__a ftr__ico" href={`mailto:${contact.email}`}><Icon name="mail" size={16} />{contact.email}</a>
        <a class="ftr__a ftr__ico" href={`tel:+55${contact.phone}`}><Icon name="phone" size={16} />{fmtTel(contact.phone)}</a>
        {contact.whatsapp && <a class="ftr__a ftr__ico" href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} />WhatsApp</a>}
        <span class="ftr__ico ftr__txt"><Icon name="pin" size={16} />{contact.city}</span>
      </div>

      <nav aria-label={f.social} class="ftr__col">
        <h2 class="ftr__h">{f.social}</h2>
        {socials.map((s) => (
          <a class="ftr__a ftr__ico" href={s.href} target="_blank" rel="noopener"><Icon name={s.icon} size={16} />{s.label}<span class="sr-only"> {ui.newTab}</span></a>
        ))}
      </nav>
    </div>
    <div class="ftr__bottom">
      <span>© {year} {SITE.name} · CNPJ {SITE.cnpj}</span>
      <span class="ftr__legal"><a class="ftr__a" href={l('/politica-de-privacidade/')}>{f.privacy}</a><button type="button" class="ftr__a ftr__btn" data-consent-open>{f.cookies}</button></span>
    </div>
  </div>
</footer>

<style>
  .ftr { position: relative; overflow: hidden; background: var(--ink-2); color: var(--on-dark-2); }
  .ftr__word { left: 50%; bottom: -70px; transform: translateX(-50%); font-size: clamp(120px, 22vw, 300px); }
  .ftr__in { position: relative; padding-block: clamp(56px, 7vw, 88px) 32px; display: flex; flex-direction: column; gap: clamp(40px, 5vw, 56px); }
  /* Marca ocupa mais espaço; 4 colunas de links. Abaixo de 1024px: 2 colunas; abaixo de 520px: 1 */
  .ftr__grid { display: grid; grid-template-columns: 1.4fr repeat(4, minmax(0, 1fr)); gap: 40px 32px; }
  .ftr__brand { gap: 18px; }
  .ftr__about { font-size: 14px; color: #a8a8a8; max-width: 300px; }
  .ftr__col { display: flex; flex-direction: column; gap: 2px; align-items: flex-start; font-size: 15px; min-width: 0; }
  .ftr__h { margin-bottom: 10px; font-size: 13px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #fff; }
  .ftr__a { display: inline-flex; align-items: center; min-height: 36px; color: var(--on-dark-2); text-decoration: none; overflow-wrap: anywhere; background-image: linear-gradient(currentColor, currentColor); background-repeat: no-repeat; background-position: 0 calc(100% - 6px); background-size: 0 1px; transition: background-size 0.3s var(--ease), color 0.2s; }
  .ftr__a:hover { color: #fff; background-size: 100% 1px; }
  .ftr__ico { gap: 10px; }
  .ftr__ico :global(svg) { flex: none; color: var(--red-lt); }
  .ftr__txt { display: inline-flex; align-items: center; min-height: 36px; }
  .ftr__nuc { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 20px; }
  .ftr__more { gap: 6px; margin-top: 6px; font-weight: 700; color: #fff; }
  .ftr__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-top: 24px; border-top: 1px solid #2e2e2e; font-size: 13px; color: #9a9a9a; }
  .ftr__legal { display: flex; flex-wrap: wrap; gap: 20px; }
  .ftr__btn { background: none; border: 0; padding: 0; cursor: pointer; font-size: 13px; }
  @media (max-width: 1100px) {
    .ftr__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ftr__brand { grid-column: 1 / -1; }
  }
  /* Celular: Instituto e Redes lado a lado; Núcleos e Contato em largura total (menos rolagem) */
  @media (max-width: 520px) {
    .ftr__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-areas: 'brand brand' 'inst soc' 'nuc nuc' 'cont cont'; gap: 32px 20px; }
    .ftr__brand { grid-area: brand; }
    .ftr__grid > :nth-child(2) { grid-area: inst; }
    .ftr__grid > :nth-child(3) { grid-area: nuc; }
    .ftr__grid > :nth-child(4) { grid-area: cont; }
    .ftr__grid > :nth-child(5) { grid-area: soc; }
  }
</style>
